rules_version = '2';

// Regras de segurança do Firestore para o AcervIF.
//
// A "apiKey" do Firebase presente no código do site é pública por design
// (https://firebase.google.com/docs/projects/api-keys) e não concede acesso
// por si só. Quem realmente decide o que pode ser lido ou escrito no banco
// é este arquivo — por isso ele precisa ser publicado no Console do
// Firebase (ou via `firebase deploy --only firestore:rules`).
//
// Por que não usar apenas "allow write: if request.auth != null"?
// Porque qualquer pessoa pode usar a apiKey pública para se autocadastrar
// via createUserWithEmailAndPassword (o provedor Email/Password do Firebase
// não permite bloquear só o cadastro mantendo o login). Uma conta assim,
// mesmo nunca tendo passado pelo admin.html, também satisfaz
// "request.auth != null" — por isso a escrita é restrita a uma allowlist
// de e-mails abaixo, não apenas a "estar logado".
//
// IMPORTANTE: substitua o e-mail abaixo pelo(s) e-mail(is) reais das contas
// administrativas cadastradas no Firebase Authentication.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email in [
               'admin@acervif.com'
             ];
    }

    // Regra global: aplica-se a todas as coleções atuais e futuras.
    match /{document=**} {
      // Qualquer um pode ler (necessário para os sites públicos funcionarem).
      allow read: if true;

      // Apenas as contas na allowlist acima, logadas via admin.html,
      // podem criar, editar ou apagar documentos.
      allow write: if isAdmin();
    }
  }
}
